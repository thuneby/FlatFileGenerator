<div class="text-center">
    <h1 class="display-4">Administration</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <section>
            <form asp-action="ExportToFile">
                <div class="mb-3">
                    <label >Filename: </label>
                    <input type ="text" name="fileName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label >FilePath: </label>
                    <input type="text" name="filePath" class="form-control" />
                </div>
                <div class="mb-3">
                    <div class="col-md-10">
                        <label >File type: </label>
                        <select id="type" name="type" class="form-select">
                            <option selected Value="1">JSON</option>
                            <option Value="2">CSV</option>
                            <option Value="3">Text</option>
                        </select>
                        <p></p>
                    </div>
                </div>
                <div class="mb-3">
                    <input type="submit" value="Export to file" class="btn btn-primary" />
                </div>
            </form>
        </section>
    </div>
</div>