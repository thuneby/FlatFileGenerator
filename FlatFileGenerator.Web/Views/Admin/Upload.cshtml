@{
    ViewData["Title"] = "Upload";
}

<h2>Upload File</h2>
<p>&nbsp;</p>

<div class="row">
    <div class="col-md-6">
        <section>
            <h3>
                Uploading a small receiptDetail file
            </h3>
            <form asp-action="Uploadfile" method="post" enctype="multipart/form-data" class="form-horizontal" role="form">
                <p>Select file:</p>
                <div class="mb-3">
                    <div class="col-md-10">
                        <input type="file" class="btn btn-secondary" name="file" id="file" />
                    </div>
                </div>
                <div class="mb-3">
                    <div class="col-md-10">
                        <select id="type" name="type" class="form-select">
                            <option Value="1">JSON</option>
                            <option Value="2">IpStandard</option>
                            <option Value="3">CSV</option>
                            <option Value="4">Excel</option>
                            <option Value="10">Nets Informationsservice</option>
                        </select>
                        <p></p>
                        <button type="submit" class="btn btn-primary">OK</button>
                    </div>
                </div>
            </form>
            <p></p>
            &nbsp;
        </section>
        <section>
            <h3>
                Uploading a Large receiptDetail file
            </h3>
            <form asp-action="UploadFromDirectory">
                <div class="mb-3">
                    <label >Filename: </label>
                    <input type="text" name="fileName" class="form-control"/>
                </div>
                <div class="mb-3">
                    <label >FilePath: </label>
                    <input type="text" name="filePath" class="form-control"/>
                </div>
                <div class="mb-3">
                    <div class="col-md-10">
                        <select id="type" name="type" class="form-select">
                            <option Value="1">JSON</option>
                            <option Value="2">IpStandard</option>
                            <option Value="3">CSV</option>
                            <option Value="4">Excel</option>
                            <option Value="10">Nets Informationsservice</option>
                        </select>
                        <p></p>
                        <button type="submit" class="btn btn-primary">OK</button>
                    </div>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('file').addEventListener('change', function (e) {
            if (this.files && this.files.length > 0) {
                var file = this.files[0];
                document.getElementById('fileName').value = file.name;
                // Browsers do not provide the full path for security reasons.
                // You can set the filePath to empty or a default value if needed.
                document.getElementById('filePath').value = '';
            }
        });
    </script>
}
    